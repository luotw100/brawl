# 直播频道栈（复制成 .env.live 填真值；.env.* 不入库）
COMPOSE_PROJECT_NAME=brawl-live
COMPOSE_PROFILES=app,edge
REPLAY_DIR=/srv/brawl/replays-live
STAGE_TOKEN=换成长随机串    # 观众画面 /#/stage 的准入 token
CONSOLE_TOKEN=换成另一个长随机串  # 导播台 /#/console 的准入 token
PACE=0.5
INTERMISSION_SECONDS=30
LOOP_POOL=true

# edge（公网 https）；不想要 edge 就把上面 COMPOSE_PROFILES 改成 app
STAGE_DOMAIN=stage.example.com
CF_API_TOKEN=
FRP_SERVER_ADDR=
FRP_TOKEN=
FRP_REMOTE_PORT=8443
